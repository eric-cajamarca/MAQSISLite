PORT=3080
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=maqsislite
# Aiven (y otros MySQL en la nube) requieren SSL:
# DB_SSL=true
# DB_SSL_CA=./ca.pem
# O pegar el contenido del certificado CA en una sola línea:
# DB_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
JWT_SECRET=cambiar-este-secreto-en-produccion
# URL pública de la app (para enlaces de recuperación de contraseña)
APP_URL=http://localhost:3080
# Correo SMTP (recuperación de contraseña)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MAQSIS <noreply@tudominio.com>
# Token de Factiliza para consultar DNI (RENIEC) y RUC (SUNAT). Obtenlo en https://factiliza.com
FACTILIZA_TOKEN=
